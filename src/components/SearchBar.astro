---
interface Props {
	resultCountId?: string;
}

const { resultCountId = 'result-count' } = Astro.props;
---
<div class="sticky top-[73px] z-30 -mx-4 mb-6 border-b border-neutral-200 bg-neutral-50/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 dark:border-neutral-800 dark:bg-neutral-950/90">
	<div class="flex items-center gap-2">
	<div class="relative flex-1">
		<svg
			class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="11" cy="11" r="8" />
			<path d="m21 21-4.3-4.3" />
		</svg>
		<input
			id="search-input"
			type="search"
			placeholder="Search dishes, ingredients, regions…"
			autocomplete="off"
			class="w-full rounded-lg border border-neutral-200 bg-white py-2 pl-9 pr-9 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100 dark:placeholder:text-neutral-500 dark:focus:border-neutral-600 dark:focus:ring-neutral-800"
		/>
		<button
			id="search-clear"
			type="button"
			class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md p-1 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-neutral-300"
			aria-label="Clear search"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M18 6 6 18M6 6l12 12" />
			</svg>
		</button>
	</div>
	<button
	id="shuffle-grid"
	type="button"
	class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-700 transition hover:bg-neutral-50 hover:text-neutral-900 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
	title="Shuffle the grid"
	aria-label="Shuffle the grid"
>
	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M16 3h5v5" />
		<path d="M4 20 21 3" />
		<path d="M21 16v5h-5" />
		<path d="m15 15 6 6" />
		<path d="M4 4l5 5" />
	</svg>
	<span class="hidden sm:inline">Shuffle</span>
</button>
</div>
	<p id={resultCountId} class="mt-2 text-xs text-neutral-500 dark:text-neutral-500" aria-live="polite"></p>
</div>

<script>
	type FilterState = Record<string, Set<string>>;

	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
	const countEl = document.getElementById('result-count');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-dish-card]'));
	const emptyState = document.getElementById('empty-state');
	const filterCheckboxes = Array.from(
		document.querySelectorAll<HTMLInputElement>('input[data-filter-group]')
	);
	const clearAllBtn = document.getElementById('filter-clear-all');

	if (cards.length) {
		const total = cards.length;
const FILTER_GROUPS = ['type', 'occasion', 'region', 'flavor_profile'] as const;

const readUrlState = () => {
	const url = new URL(window.location.href);
	const q = url.searchParams.get('q') ?? '';
	const filters: Record<string, Set<string>> = {};
	for (const group of FILTER_GROUPS) {
		const raw = url.searchParams.get(group);
		if (raw) filters[group] = new Set(raw.split(',').filter(Boolean));
	}
	return { q, filters };
};

const writeUrlState = () => {
	const url = new URL(window.location.href);
	const q = input?.value.trim() ?? '';
	const filters = getFilters();

	if (q) url.searchParams.set('q', q);
	else url.searchParams.delete('q');

	for (const group of FILTER_GROUPS) {
		const values = filters[group];
		if (values && values.size > 0) {
			url.searchParams.set(group, Array.from(values).join(','));
		} else {
			url.searchParams.delete(group);
		}
	}

	history.replaceState(history.state, '', url);
};

		let debounceTimer: number;

		const getFilters = (): FilterState => {
			const state: FilterState = {};
			for (const cb of filterCheckboxes) {
				if (!cb.checked) continue;
				const group = cb.dataset.filterGroup!;
				const value = cb.dataset.filterValue!;
				if (!state[group]) state[group] = new Set();
				state[group].add(value);
			}
			return state;
		};

		const cardMatchesFilters = (card: HTMLElement, filters: FilterState): boolean => {
			// AND across groups, OR within a group.
			for (const [group, values] of Object.entries(filters)) {
				const cardValues = (card.dataset[`group${capitalize(group)}`] ?? '').split('|');
				const hasMatch = [...values].some((v) => cardValues.includes(v));
				if (!hasMatch) return false;
			}
			return true;
		};

		const matchesQuery = (card: HTMLElement, query: string) => {
			if (query === '') return true;
			return (card.dataset.search ?? '').toLowerCase().includes(query.toLowerCase());
		};

		const apply = () => {
			const query = input?.value.trim() ?? '';
			const filters = getFilters();
			const hasFilters = Object.keys(filters).length > 0;
			let visible = 0;

			for (const card of cards) {
				const show = matchesQuery(card, query) && cardMatchesFilters(card, filters);
				card.classList.toggle('hidden', !show);
				if (show) visible++;
			}

			if (countEl) {
				const isFiltered = query !== '' || hasFilters;
				countEl.textContent = isFiltered
					? `${visible} of ${total} ${visible === 1 ? 'dish' : 'dishes'}`
					: `${total} dishes`;
			}

			emptyState?.classList.toggle('hidden', visible > 0);
			clearBtn?.classList.toggle('hidden', query === '');
			clearAllBtn?.classList.toggle('hidden', !hasFilters);

            writeUrlState();
		};

		input?.addEventListener('input', () => {
			window.clearTimeout(debounceTimer);
			debounceTimer = window.setTimeout(apply, 150);
		});

		clearBtn?.addEventListener('click', () => {
			if (input) {
				input.value = '';
				input.focus();
			}
			apply();
		});

		for (const cb of filterCheckboxes) {
			cb.addEventListener('change', apply);
		}

		clearAllBtn?.addEventListener('click', () => {
			for (const cb of filterCheckboxes) cb.checked = false;
			apply();
		});

		// Hydrate state from URL on initial load
        const { q: initialQuery, filters: initialFilters } = readUrlState();
        if (input && initialQuery) input.value = initialQuery;
        for (const cb of filterCheckboxes) {
        const group = cb.dataset.filterGroup;
        const value = cb.dataset.filterValue;
        if (group && value && initialFilters[group]?.has(value)) {
            cb.checked = true;
        }
    }

    apply();

	}

	function capitalize(s: string) {
		return s.charAt(0).toUpperCase() + s.slice(1);
	}

    const shuffleBtn = document.getElementById('shuffle-grid');

    if (shuffleBtn && cards.length) {
        const grid = cards[0].parentElement;

        shuffleBtn.addEventListener('click', () => {
            if (!grid) return;
            // Fisher-Yates shuffle on a copy of the cards array
            const shuffled = [...cards];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            // Re-append in new order (preserves event listeners, etc.)
            const fragment = document.createDocumentFragment();
            shuffled.forEach((card) => fragment.appendChild(card));
            grid.appendChild(fragment);
        });
    }
</script>