---
interface Props {
	resultCountId?: string;
}

const { resultCountId = 'result-count' } = Astro.props;
---
<div class="sticky top-[73px] z-30 -mx-4 mb-6 border-b border-neutral-200 bg-neutral-50/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 dark:border-neutral-800 dark:bg-neutral-950/90">
	<div class="relative">
		<svg
			class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="11" cy="11" r="8" />
			<path d="m21 21-4.3-4.3" />
		</svg>
		<input
			id="search-input"
			type="search"
			placeholder="Search dishes, ingredients, regions…"
			autocomplete="off"
			class="w-full rounded-lg border border-neutral-200 bg-white py-2 pl-9 pr-9 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-200 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100 dark:placeholder:text-neutral-500 dark:focus:border-neutral-600 dark:focus:ring-neutral-800"
		/>
		<button
			id="search-clear"
			type="button"
			class="absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-md p-1 text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-800 dark:hover:text-neutral-300"
			aria-label="Clear search"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M18 6 6 18M6 6l12 12" />
			</svg>
		</button>
	</div>
	<p id={resultCountId} class="mt-2 text-xs text-neutral-500 dark:text-neutral-500" aria-live="polite"></p>
</div>

<script>
	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const clearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
	const countEl = document.getElementById('result-count');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-dish-card]'));
	const emptyState = document.getElementById('empty-state');

	if (input && cards.length) {
		const total = cards.length;
		let debounceTimer: number;

		const matches = (haystack: string, needle: string) =>
			haystack.toLowerCase().includes(needle.toLowerCase());

		const applyFilter = (query: string) => {
			const q = query.trim();
			let visible = 0;

			for (const card of cards) {
				const haystack = card.dataset.search ?? '';
				const show = q === '' || matches(haystack, q);
				card.classList.toggle('hidden', !show);
				if (show) visible++;
			}

			if (countEl) {
				countEl.textContent = q === ''
					? `${total} dishes`
					: `${visible} of ${total} ${visible === 1 ? 'dish' : 'dishes'}`;
			}

			if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
			if (clearBtn) clearBtn.classList.toggle('hidden', q === '');
		};

		input.addEventListener('input', () => {
			window.clearTimeout(debounceTimer);
			debounceTimer = window.setTimeout(() => applyFilter(input.value), 150);
		});

		clearBtn?.addEventListener('click', () => {
			input.value = '';
			applyFilter('');
			input.focus();
		});

		// Initial count
		applyFilter('');
	}
</script>