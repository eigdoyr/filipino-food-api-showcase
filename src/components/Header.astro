---
const navLinks = [
	{ href: 'https://github.com/eigdoyr/filipino-food-api', label: 'API repo' },
	{ href: 'https://ryodgie.mintlify.app/introduction', label: 'Docs' },
	{ href: 'https://filipino-food-api.ryodgie.workers.dev/docs', label: 'Swagger' },
];
---
<header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/80">
	<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-6 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center gap-2 font-semibold text-neutral-900 dark:text-neutral-100">
			Filipino Food API
		</a>
		<nav class="flex items-center gap-4 text-sm">
    {navLinks.map(({ href, label }) => (
        
         <a href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-600 transition hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
        >
            {label}
        </a>
    ))}
</nav>
	</div>
</header>