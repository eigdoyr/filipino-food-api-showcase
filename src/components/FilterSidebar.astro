---
import type { FilterOptions } from '../lib/api';

interface Props {
	options: FilterOptions;
}

const { options } = Astro.props;

const groups: { key: keyof FilterOptions; label: string }[] = [
	{ key: 'type', label: 'Type' },
	{ key: 'occasion', label: 'Occasion' },
	{ key: 'region', label: 'Region' },
	{ key: 'flavor_profile', label: 'Flavor' },
];

const formatLabel = (v: string) =>
	v.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
---
<aside
	id="filter-sidebar"
	class="lg:sticky lg:top-[140px] lg:h-fit lg:w-64 lg:shrink-0"
>
	{/* Mobile drawer backdrop */}
	<div
		id="filter-backdrop"
		class="fixed inset-0 z-40 hidden bg-neutral-900/50 backdrop-blur-sm lg:hidden"
		aria-hidden="true"
	></div>

	{/* Sidebar panel */}
	<div
		id="filter-panel"
		class="fixed inset-y-0 left-0 z-50 hidden w-72 overflow-y-auto border-r border-neutral-200 bg-white p-4 lg:static lg:block lg:w-auto lg:border-0 lg:bg-transparent lg:p-0 dark:border-neutral-800 dark:bg-neutral-950 lg:dark:bg-transparent"
	>
		<div class="mb-4 flex items-center justify-between lg:hidden">
			<h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Filters</h2>
			<button
				id="filter-close"
				type="button"
				class="rounded-md p-1.5 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-800"
				aria-label="Close filters"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
		</div>

		<div class="space-y-5">
			{groups.map(({ key, label }) => (
				<details class="group">
					<summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-neutral-900 marker:hidden [&::-webkit-details-marker]:hidden dark:text-neutral-100">
						<span>{label}</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m6 9 6 6 6-6" />
						</svg>
					</summary>
					<div class="mt-2 space-y-1.5">
						{options[key].map((value) => (
							<label class="flex cursor-pointer items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300">
								<input
									type="checkbox"
									data-filter-group={key}
									data-filter-value={value}
									class="h-4 w-4 rounded border-neutral-300 text-neutral-900 focus:ring-neutral-400 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100"
								/>
								<span>{formatLabel(value)}</span>
							</label>
						))}
					</div>
				</details>
			))}
		</div>

		<button
			id="filter-clear-all"
			type="button"
			class="mt-6 hidden w-full rounded-md border border-neutral-200 px-3 py-2 text-sm text-neutral-700 transition hover:bg-neutral-50 dark:border-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-900"
		>
			Clear all filters
		</button>
	</div>
</aside>
<script>
	const openBtn = document.getElementById('filter-open');
	const closeBtn = document.getElementById('filter-close');
	const panel = document.getElementById('filter-panel');
	const backdrop = document.getElementById('filter-backdrop');

	const open = () => {
		panel?.classList.remove('hidden');
		backdrop?.classList.remove('hidden');
		document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
	};

	const close = () => {
		panel?.classList.add('hidden');
		backdrop?.classList.add('hidden');
		document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
	};

	openBtn?.addEventListener('click', open);
	closeBtn?.addEventListener('click', close);
	backdrop?.addEventListener('click', close);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !panel?.classList.contains('hidden')) close();
	});
</script>