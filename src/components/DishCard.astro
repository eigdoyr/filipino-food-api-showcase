---
import type { Dish } from '../lib/types';

interface Props {
	dish: Dish;
}

const { dish } = Astro.props;
---
<article class="group overflow-hidden rounded-xl border border-neutral-200 bg-white transition hover:border-neutral-300 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700">
	<div class="aspect-[4/3] overflow-hidden bg-neutral-100 dark:bg-neutral-800">
		<img
			src={dish.image_url}
			alt={dish.name}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
		/>
	</div>
	<div class="p-4">
		<h3 class="font-semibold text-neutral-900 dark:text-neutral-100">{dish.name}</h3>
		<p class="mt-1 line-clamp-2 text-sm text-neutral-600 dark:text-neutral-400">
			{dish.description}
		</p>
		<div class="mt-3 flex flex-wrap gap-1">
			{dish.type.slice(0, 2).map((t) => (
				<span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
					{t.replace(/_/g, ' ')}
				</span>
			))}
		</div>
	</div>
</article>